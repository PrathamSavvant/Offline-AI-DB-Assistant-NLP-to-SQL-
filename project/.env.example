# ==============================================================================
# AI Database Assistant & Understanding Engine - Environment Configuration
# Copy this file to .env and configure values for your environment.
# ==============================================================================

# Application Environment (production | development | testing)
ENVIRONMENT=production
# Leave empty for the desktop launcher to provision a persistent random key.
# Set your own random value if running the server manually.
SECRET_KEY=

# Production WSGI Server (Waitress)
SERVER_HOST=127.0.0.1
SERVER_PORT=5000
WAITRESS_THREADS=8
WAITRESS_CONNECTION_LIMIT=100
WAITRESS_CHANNEL_TIMEOUT=120
MAX_CONTENT_LENGTH=16777216

# Cross-Origin Resource Sharing (CORS)
# Keep empty for the offline same-origin desktop app.
CORS_ORIGINS=
ENABLE_SENSITIVE_DEBUG=false

# Logging & Observability (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# MySQL Database Target
DB_HOST=localhost
DB_PORT=3306
DB_USER=readonly_user
DB_PASSWORD=your_mysql_password_here
DB_NAME=CHANGE_ME
DB_POOL_SIZE=8
DB_CONNECT_TIMEOUT=10
DB_READ_TIMEOUT=30
DB_QUERY_TIMEOUT_MS=30000
DB_MAX_ESTIMATED_SCAN_ROWS=2000000
DB_MAX_ESTIMATED_JOIN_ROWS=5000000
# Set this from the DBA's visible-table inventory before acceptance testing.
DB_EXPECTED_MIN_TABLES=0

# Local LLM Server (llama.cpp server or Ollama OpenAI-compatible endpoint)
LLM_ENDPOINT=http://localhost:8080
LLM_MODEL=local-model
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.1
LLM_REPEAT_PENALTY=1.15
LLM_MAX_TOKENS=384

# Guardrails & Context Budgeting
MAX_CONTEXT_TABLES=4
MAX_CONTEXT_COLUMNS_PER_TABLE=12
SEMANTIC_CONTEXT_MAX_CHARS=480
MAX_PROMPT_CHARS=18000
SQL_ROW_LIMIT=200

# Background Schema Synchronization
ENABLE_BACKGROUND_SYNC=true
SYNC_INTERVAL_MINUTES=15
